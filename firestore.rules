rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for role-based authentication
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isStaff() {
      return isAuthenticated();
    }

    // 1. Restaurant Settings & Branding
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // 2. Menu Categories & Menu Items
    match /categories/{catId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /menuItems/{itemId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // 3. Tables & Floor Structure
    match /tables/{tableId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // 4. Orders & Kitchen Tickets
    // Authenticated staff have full access; unauthenticated customers can only create orders
    // and read active dining orders (completed/cancelled history and global dumps are blocked)
    match /orders/{orderId} {
      allow create: if true;
      allow update, delete: if isAuthenticated();
      allow get: if isAuthenticated() || (resource.data.status in ['active', 'preparing', 'ready', 'served']);
      allow list: if isAuthenticated() || (resource.data.status in ['active', 'preparing', 'ready', 'served']);
    }

    // 5. Payments & Invoices (Staff & Admin Only - Financial Protection)
    match /payments/{paymentId} {
      allow read, write: if isAuthenticated();
    }

    // 6. Inventory, Suppliers & Purchase Orders (Staff & Admin Only)
    match /inventory/{itemId} {
      allow read, write: if isAuthenticated();
    }

    match /suppliers/{supplierId} {
      allow read, write: if isAuthenticated();
    }

    match /purchases/{purchaseId} {
      allow read, write: if isAuthenticated();
    }

    // 7. Staff & Employee Records
    match /employees/{empId} {
      allow read, write: if isAuthenticated();
    }

    // 8. User Accounts (Admin & Staff)
    match /users/{userId} {
      allow read, write: if true;
    }

    // 9. Notifications
    match /notifications/{notifId} {
      allow read, create: if true;
      allow update, delete: if isAuthenticated();
    }
  }
}
